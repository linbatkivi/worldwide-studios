# Kopiér til .env og ret. Intet af det her må ligge i Git.
PORT=8787
DB_PATH=./data/worldwide.db

# Skal være en lang tilfældig tekst (fx: openssl rand -base64 32). Skift den ALDRIG, når der er konti.
PASSWORD_PEPPER=

# Nulstilling af adgangskode pr. mail. Uden en af de to er funktionen slået fra.
#   RESEND_API_KEY + MAIL_FROM sender rigtige mails (afsenderadressen skal være verificeret hos Resend)
#   MAIL_MODE=console skriver koden i loggen (kun til udvikling)
RESEND_API_KEY=
MAIL_FROM=Worldwide (Studios) <konto@dit-domæne.dk>
MAIL_MODE=

# Bag en proxy: navnet på headeren med klientens adresse (Fly: fly-client-ip)
IP_HEADER=
