            "en": "Controls"
          },
          "v": {
            "da": "WASD, mus, mellemrum, Shift og E",
            "en": "WASD, mouse, space, Shift and E"
          }
        },
        {
          "k": {
            "da": "Udseende",
            "en": "Look"
          },
          "v": {
            "da": "N64-stil, PNG'en i fuld opløsning",
            "en": "N64 style, the PNG at full resolution"
          }
